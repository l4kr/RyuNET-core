doctype html
mixin li_menu_item(icon, label, link)
  li
    a.has-icon(class=((title == label && plugin == 'core') ? 'is-active' : '') href=link)
      span.icon
        i.mdi(class='mdi-'+icon)
      span.menu-item-label #{label}

mixin li_plugin(icon, label, link, pages)
  li(class=(plugin == link) ? 'is-active' : '')
    a.has-icon.has-dropdown-icon(class=(plugin == link) ? 'is-active' : '' href='/plugin/' + link)
      span.icon
        i.mdi(class='mdi-'+icon)
      span.menu-item-label.expandable #{label}
      .dropdown-icon
        span.icon.plus
          i.mdi.mdi-plus
        span.icon.minus
          i.mdi.mdi-minus
    ul
      li
        a(href=`/plugin/${link}` class=(((plugin == link) && (subidentifier == 'overview')) ? 'is-active' : ''))
          span Overview
        if admin
          a(href=`/plugin/${link}/profiles` class=(((plugin == link) && (subidentifier == 'profiles')) ? 'is-active' : ''))
            span Profiles
        else
          a(href=`/plugin/${link}/my-profile` class=(((plugin == link) && (subidentifier == 'profiles')) ? 'is-active' : ''))
            span Profile
        each page in pages
          a(href=`/plugin/${link}/${page.link}` class=(((plugin == link) && (subidentifier == page.link)) ? 'is-active' : ''))
            span #{page.name}
html.has-aside-left.has-aside-mobile-transition.has-navbar-fixed-top.has-aside-expanded(class=aside ? 'has-aside-mobile-expanded' : '')
  head
    meta(charset="utf-8")
    meta(http-equiv="X-UA-Compatible", content="ie=edge")
    meta(name="viewport", content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0")
    title RyuNET - #{title}
      if subtitle
        |
        | &gt; #{subtitle}
    link(rel="stylesheet", href="/static/css/bulma.min.css")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/flag-icons/7.2.1/css/flag-icons.min.css")
    link(rel="stylesheet", href="/static/css/margin.min.css")
    link(rel="stylesheet", href="/static/css/materialdesignicons.min.css")
    link(rel="stylesheet", href="/static/css/tooltip.min.css")
    link(rel="stylesheet", href="/static/css/style.css")
    link(rel="stylesheet", href="/static/css/simplebar.min.css")
    script(type="text/javascript" src="/static/js/axios.min.js")
    script(type="text/javascript" src="/static/js/jquery-3.5.1.min.js")
    script(type="text/javascript" src="/static/js/jdenticon-2.2.0.min.js")
    script(type="text/javascript" src="/static/js/geopattern.min.js")
    script(type="text/javascript" src="/static/js/js.cookie-2.2.1.min.js")
    script(type="text/javascript" src="/static/js/simplebar.min.js")
    script(type="text/javascript" src="/static/js/exposed.js")
    block head
    link(rel="stylesheet", href="/static/css/bulma-fix.css")
    link(rel="stylesheet", href="/static/css/modern.css")
    style.
      .live-score-toasts { position: fixed; bottom: 16px; right: 16px; z-index: 9999; display: flex; flex-direction: column-reverse; gap: 8px; pointer-events: none; max-width: 320px; }
      .live-score-toast { pointer-events: auto; display: flex; align-items: center; gap: 10px; background: rgba(20,20,32,0.95); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 10px 12px; box-shadow: 0 6px 20px rgba(0,0,0,0.4); animation: live-toast-in 0.25s ease-out; cursor: default; }
      .live-score-toast.is-leaving { animation: live-toast-out 0.25s ease-in forwards; }
      .live-score-toast img.live-toast-jacket { width: 40px; height: 40px; border-radius: 6px; object-fit: cover; flex-shrink: 0; background: #222; }
      .live-score-toast .live-toast-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
      .live-score-toast .live-toast-title { font-size: 12px; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 220px; }
      .live-score-toast .live-toast-meta { font-size: 11px; color: rgba(255,255,255,0.6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 220px; }
      .live-score-toast .live-toast-score { font-size: 11px; font-weight: 700; color: #44ffcc; font-variant-numeric: tabular-nums; }
      .live-score-toast.is-new-best .live-toast-score { color: #ffd700; }
      @keyframes live-toast-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
      @keyframes live-toast-out { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(10px); } }
    noscript
      style
        .
          .simplebar-content-wrapper {
            overflow: auto;
          }
  body
    #app
      nav.navbar.is-fixed-top.is-info.is-mobile#navbar-main
        .navbar-brand
          a.navbar-item.is-hidden-desktop.jb-aside-mobile-toggle
            span.icon
              i.mdi.mdi-24px
          .navbar-item
            .image.is-24x24.logo
              img(src="/static/img/logo.png")
            span RyuNET
        .navbar-brand.is-right
          a.navbar-item.is-hidden-desktop.jb-navbar-menu-toggle(data-target="navbar-menu")
            span.icon
              i.mdi.mdi-dots-vertical
        .navbar-menu#navbar-menu
          .navbar-end
            .navbar-item.has-dropdown.has-dropdown-with-icons.has-divider.is-hoverable
              a.navbar-link.is-arrowless
                span.tag.is-success.is-light#online-users-badge(style="margin-right: 10px; display: none;") Online: ?
                span.icon
                  i.mdi.mdi-account-circle
                if user
                  span #{user}
                else
                  span Guest
                span.icon
                  i.mdi.mdi-chevron-down
              .navbar-dropdown.is-right
                if user
                  a.navbar-item(href="/account")
                    span.icon
                      i.mdi.mdi-account-cog
                    span Account Settings
                  hr.navbar-divider
                  a.navbar-item(href="/logout")
                    span.icon
                      i.mdi.mdi-logout
                    span Logout
                else
                  a.navbar-item(href="/")
                    span.icon
                      i.mdi.mdi-login
                    span Login
      aside.aside.is-placed-left.is-expanded(data-simplebar)
        .aside-tools
          .aside-tools-label
            span Home
        .menu.is-menu-main
          p.menu-label Panel
          ul.menu-list
            if admin
              +li_menu_item("desktop-mac", "Dashboard", "/")
            
            +li_menu_item("help-circle", "About", "/about")
            
            if admin
              +li_menu_item("account-circle", "Profiles", "/profiles")
            else if user
              +li_menu_item("account-circle", "Profile", "/my-profile")
            
            +li_menu_item("trophy", "Leaderboard", "/leaderboard?game=sdvx")
            
            +li_menu_item("radar", "Live Feed", "/live-feed")
            
            li
              a.has-icon(style="opacity: 0.6; cursor: not-allowed;" title="Coming Soon")
                span.icon
                  i.mdi.mdi-account-group
                span.menu-item-label Team
                span.tag.is-small.is-warning(style="margin-left:auto; font-weight:bold; border-radius:4px; padding:0 6px;") Soon...
            
            if admin
              +li_menu_item("database", "Data Management", "/data")
            
            if user
              +li_menu_item("account-cog", "Account", "/account")
              +li_menu_item("credit-card-outline", "Cards", "/cards")
              +li_menu_item("gamepad-variant", "Cabinets", "/cabinets")
            
            if admin
              +li_menu_item("account-group", "Users", "/users")
          if user
            p.menu-label Games
            ul.menu-list
              each plugin in plugins
                -
                  var link = plugin.id;
                  var label = plugin.name.toUpperCase();
                  var char = link[0].toLowerCase();
                  var isAlpha = /[a-zA-Z]/.test(char);
                  var isNumeric = /[0-9]/.test(char);
                  var icon = isAlpha ? `alpha-${char}-circle` : (isNumeric ? `numeric-${char}-circle` : 'record-circle');
                +li_plugin(icon, label, link, plugin.pages)
      .content#main-content(data-simplebar)
        section.hero.is-hero-bar
          .hero-body
            p.title #{title}
              if subtitle
                span.subtitle
                  |
                  span.is-size-6.has-text-grey-light &gt;
                  |
                  span.has-text-grey #{subtitle}
              if subsubtitle
                span.subtitle
                  |
                  span.is-size-6.has-text-grey-light &gt;
                  |
                  span.has-text-grey #{subsubtitle}

        block content

      footer.footer
        .content.has-text-centered
          p
            | Made with
            span.icon.has-text-danger
              i.mdi.mdi-heart
            | by Team Asphyxia | Modified by Beafowl & Ryu7w7 | Plugins by
            |
            a(href="/about") Community

      block modal

      #live-score-toasts.live-score-toasts

      script(type="text/javascript" src="/static/js/main.js")
      script.
        function updateOnlineUsers() {
          fetch('/api/online-users')
            .then(r => r.json())
            .then(data => {
              const badge = document.getElementById('online-users-badge');
              if (badge) {
                badge.textContent = `Online: ${data.online}`;
                badge.style.display = 'inline-flex';
              }
            })
            .catch(console.error);
        }
        document.addEventListener('DOMContentLoaded', () => {
          updateOnlineUsers();
          setInterval(updateOnlineUsers, 30000);
        });
      script.
        window.jdenticon_config = {
            backColor: "#222"
        };
      script.
        (function() {
          var TOAST_LIMIT = 4;
          var TOAST_LIFETIME_MS = 7000;

          function fmtNum(n) {
            return Number(n || 0).toLocaleString();
          }

          function buildToast(evt) {
            var el = document.createElement('div');
            el.className = 'live-score-toast' + (evt.isNewBest ? ' is-new-best' : '');

            var title = evt.title || ('Chart #' + (evt.mid != null ? evt.mid : '?'));
            var diff = evt.diff ? String(evt.diff).toUpperCase() : '';
            var who = evt.username || 'A player';

            var judgementBits = [];
            if (evt.critical != null) judgementBits.push('CRIT ' + fmtNum(evt.critical));
            if (evt.near != null) judgementBits.push('NEAR ' + fmtNum(evt.near));
            if (evt.error != null) judgementBits.push('ERR ' + fmtNum(evt.error));

            var jacketHtml = evt.jacketUrl
              ? '<img class="live-toast-jacket" src="' + evt.jacketUrl + '" onerror="this.onerror=null;this.src=\'https://jackets.ryu7w7.xyz/sdvx/jk_dummy.png\';">'
              : '';

            el.innerHTML =
              jacketHtml +
              '<div class="live-toast-body">' +
                '<div class="live-toast-title">' + who + (evt.isNewBest ? ' \u2b50' : '') + '</div>' +
                '<div class="live-toast-meta">' + title + (diff ? ' [' + diff + ']' : '') + '</div>' +
                '<div class="live-toast-score">' + fmtNum(evt.score) +
                  (judgementBits.length ? ' \u00b7 ' + judgementBits.join(' \u00b7 ') : '') +
                '</div>' +
              '</div>';

            return el;
          }

          function pushToast(evt) {
            var container = document.getElementById('live-score-toasts');
            if (!container) return;

            var el = buildToast(evt);
            container.appendChild(el);

            while (container.children.length > TOAST_LIMIT) {
              container.removeChild(container.firstChild);
            }

            setTimeout(function() {
              el.classList.add('is-leaving');
              setTimeout(function() {
                if (el.parentNode) el.parentNode.removeChild(el);
              }, 300);
            }, TOAST_LIFETIME_MS);
          }

          function connectLiveScores() {
            if (typeof EventSource === 'undefined') return;

            var source = new EventSource('/live/scores');
            source.addEventListener('score', function(e) {
              try {
                var evt = JSON.parse(e.data);
                pushToast(evt);
                // Let page-specific scripts (e.g. a profile page viewing its
                // own refid) react and update in-page content live, without
                // needing a second SSE connection per page.
                window.dispatchEvent(new CustomEvent('live-score', { detail: evt }));
              } catch (err) {
                console.error('Failed to parse live score event', err);
              }
            });
            source.onerror = function() {
              // Browser auto-reconnects; nothing to do here.
            };
          }

          document.addEventListener('DOMContentLoaded', connectLiveScores);
        })();
      block scripts
