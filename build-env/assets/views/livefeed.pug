extends _layout.pug

block content
  style.
    .live-feed-card { display: flex; align-items: center; background: rgba(255,255,255,0.04); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); border-radius: 12px; padding: 10px 16px; margin-bottom: 8px; border: 1px solid rgba(255,255,255,0.08); cursor: pointer; transition: background 0.15s ease, transform 0.15s ease, border-color 0.15s ease; }
    .live-feed-card:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.16); transform: translateY(-1px); }
    .live-feed-card.live-recent-play { animation: live-feed-in 1.6s ease-out; }
    @keyframes live-feed-in {
      0% { background-color: rgba(68,255,204,0.22); }
      100% { background-color: rgba(255,255,255,0.04); }
    }
    .live-feed-avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; margin-right: 12px; flex-shrink: 0; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); }
    .live-feed-jacket { width: 48px; height: 48px; border-radius: 8px; margin-right: 14px; object-fit: cover; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); flex-shrink: 0; }
    .live-feed-info { flex: 1; min-width: 0; text-align: left; }
    .live-feed-user { font-weight: 700; color: #fff; }
    .live-feed-title { color: #66c2ff; font-weight: 600; }
    .live-feed-meta { font-size: 0.8rem; color: rgba(255,255,255,0.55); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .live-feed-stats { display: flex; flex-direction: column; align-items: flex-end; margin-left: 16px; flex-shrink: 0; }
    .live-feed-score { font-size: 1.1rem; font-weight: bold; color: #fff; }
    .live-feed-date { font-size: 0.75rem; color: rgba(255,255,255,0.45); margin-top: 2px; white-space: nowrap; }

    .clear-puc { border-left: 4px solid #ffd700 !important; }
    .clear-uc { border-left: 4px solid #ff4081 !important; }
    .clear-exc { border-left: 4px solid #00d1b2 !important; }
    .clear-comp { border-left: 4px solid #209cee !important; }
    .clear-fail { border-left: 4px solid #555 !important; }

    /* --- Detail modal (same design language as the profile score modal) --- */
    @keyframes modal-in { from { transform: scale(0.85) translateY(20px); opacity: 0; } to { transform: scale(1) translateY(0); opacity: 1; } }
    .score-modal-content { font-family: 'Outfit', sans-serif, system-ui; background: rgba(13, 13, 20, 0.97); border-radius: 16px; box-shadow: 0 0 0 1px rgba(255,255,255,0.08), 0 20px 60px rgba(0,0,0,0.8); color: #fff; padding: 0; overflow: hidden; width: 820px; max-width: 95vw; animation: modal-in 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275) both; }
    .score-header { padding: 20px 24px 16px; position: relative; background: linear-gradient(135deg, #1c1c2e 0%, #12121e 100%); border-bottom: 1px solid rgba(255,255,255,0.06); display: flex; align-items: center; gap: 16px; }
    .score-header-jacket { width: 72px; height: 72px; border-radius: 8px; object-fit: cover; flex-shrink: 0; border: 1px solid rgba(255,255,255,0.12); background: #111; }
    .score-header-text { flex: 1; min-width: 0; }
    .score-header h2 { margin: 0 0 6px 0; font-size: 24px; font-weight: 800; letter-spacing: -0.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; color: #fff; }
    .score-subtitle .diff-badge { padding: 3px 12px; border-radius: 4px; font-weight: 700; font-size: 13px; letter-spacing: 1px; background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2); text-transform: uppercase; }
    .score-played-by { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
    .score-played-by-avatar { width: 24px; height: 24px; border-radius: 50%; object-fit: cover; border: 1px solid rgba(255,255,255,0.2); flex-shrink: 0; }
    .score-played-by-text { font-size: 12px; color: rgba(255,255,255,0.45); font-weight: 500; }
    .score-played-by-name { font-size: 12px; color: rgba(255,255,255,0.8); font-weight: 700; margin-left: 2px; }
    .score-body { display: flex; padding: 28px 24px 28px 20px; gap: 20px; position: relative; background: linear-gradient(180deg, #0f0f1a 0%, #0a0a12 100%); align-items: center; overflow: visible; flex-wrap: wrap; }
    .score-rank-container { flex: 0 0 160px; min-width: 160px; display: flex; justify-content: center; align-items: center; position: relative; padding: 14px 10px; overflow: visible; }
    .score-rank-container::before { content: ''; position: absolute; width: 140px; height: 140px; border-radius: 50%; background: var(--rank-color, rgba(255, 120, 0, 0.2)); filter: blur(35px); z-index: 0; }
    #lf-modal-rank { font-size: 90px; font-weight: 900; font-style: italic; line-height: 1.3; padding: 4px 10px; position: relative; z-index: 1; background: var(--rank-gradient, linear-gradient(180deg, #ffb84d 0%, #ff6600 100%)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 4px 12px var(--rank-shadow, rgba(255,102,0,0.5))); user-select: none; white-space: nowrap; display: inline-block; }
    #lf-modal-rank[data-grade="S"] { --rank-gradient: linear-gradient(180deg, #ffe066 0%, #ffaa00 100%); --rank-shadow: rgba(255,170,0,0.6); --rank-color: rgba(255,170,0,0.2); font-size: 92px; }
    #lf-modal-rank[data-grade="AAA+"] { --rank-gradient: linear-gradient(180deg, #ff88cc 0%, #cc44aa 100%); --rank-shadow: rgba(200,50,150,0.6); --rank-color: rgba(200,50,150,0.2); font-size: 50px; }
    #lf-modal-rank[data-grade="AAA"] { --rank-gradient: linear-gradient(180deg, #bb88ff 0%, #7733cc 100%); --rank-shadow: rgba(100,50,200,0.6); --rank-color: rgba(100,50,200,0.2); font-size: 64px; }
    #lf-modal-rank[data-grade="AA+"] { --rank-gradient: linear-gradient(180deg, #66aaff 0%, #2255cc 100%); --rank-shadow: rgba(30,80,200,0.6); --rank-color: rgba(30,80,200,0.2); font-size: 58px; }
    #lf-modal-rank[data-grade="AA"] { --rank-gradient: linear-gradient(180deg, #66aaff 0%, #2255cc 100%); --rank-shadow: rgba(30,80,200,0.6); --rank-color: rgba(30,80,200,0.2); font-size: 74px; }
    #lf-modal-rank[data-grade="A+"] { --rank-gradient: linear-gradient(180deg, #66ffdd 0%, #00aa88 100%); --rank-shadow: rgba(0,150,100,0.5); --rank-color: rgba(0,150,100,0.2); font-size: 68px; }
    #lf-modal-rank[data-grade="A"] { --rank-gradient: linear-gradient(180deg, #66ffdd 0%, #00aa88 100%); --rank-shadow: rgba(0,150,100,0.5); --rank-color: rgba(0,150,100,0.2); font-size: 86px; }
    .score-stats { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 6px; min-width: 200px; }
    .score-number { font-size: 58px; font-weight: 200; letter-spacing: -2px; line-height: 1; font-variant-numeric: tabular-nums; }
    .score-meta-row { display: flex; gap: 20px; margin-top: 8px; }
    .score-meta-item { display: flex; flex-direction: column; gap: 2px; }
    .score-meta-label { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.4); font-weight: 600; }
    .score-meta-value { font-size: 22px; font-weight: 700; color: #fff; font-variant-numeric: tabular-nums; }
    .score-medal-row { margin-top: 10px; }
    .judgements-container { flex: 0 0 220px; background: rgba(0,0,0,0.4); border-radius: 10px; padding: 18px; border: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; gap: 14px; }
    .judgements-title { font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.4); font-weight: 700; margin-bottom: -4px; }
    .judgement-row { display: flex; align-items: center; gap: 8px; }
    .j-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .j-label { flex: 1; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; opacity: 0.85; }
    .j-value { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; min-width: 55px; }
    .j-sub-row { display: flex; justify-content: flex-end; gap: 12px; font-size: 11px; color: rgba(255,255,255,0.4); font-weight: 600; margin-top: -8px; padding-right: 2px; }
    .j-sub-item .arrow-early { color: #44bbff; }
    .j-sub-item .arrow-late { color: #ff8844; }

    .j-row-crit .j-dot { background: #ffaa00; }
    .j-row-crit .j-label, .j-row-crit .j-value { color: #ffaa00; }
    .j-row-near .j-dot { background: #44ffcc; }
    .j-row-near .j-label, .j-row-near .j-value { color: #44ffcc; }
    .j-row-error .j-dot { background: #ff3344; }
    .j-row-error .j-label, .j-row-error .j-value { color: #ff3344; }
    .modal-close { position: fixed; top: 20px; right: 20px; }

  - const getClearClass = (clearVal) => { const c = Number(clearVal); if (c === 5) return 'clear-puc'; if (c === 4) return 'clear-uc'; if (c === 3) return 'clear-exc'; if (c === 2) return 'clear-comp'; if (c === 1) return 'clear-fail'; return ''; }

  section.section.is-main-section
    .box(style="position: relative; z-index: 100;")
      h2.title.is-4
        span.icon(style="color: #44ffcc;")
          i.mdi.mdi-radar
        |  Live Feed
      p.subtitle.is-6(style="color: #999;") The 100 most recent SDVX plays across the server, updated live as scores come in. Click a play for full timing details.

      if plays && plays.length > 0
        ul#live-feed-list(style="list-style: none; padding: 0;")
          each play in plays
            li.live-feed-card(class=(play.clear ? getClearClass(play.clear) : '') onclick="openLiveFeedModal(this)" data-play=JSON.stringify(play))
              img.live-feed-avatar(src=play.avatarUrl onerror="this.src='/static/img/avatar.jpg'")
              img.live-feed-jacket(src=play.jacketUrl onerror="jacketFallback(this)")
              .live-feed-info
                div
                  span.live-feed-user #{play.username}
                  |  played 
                  span.live-feed-title #{play.title} [#{play.diff}]
                .live-feed-meta CRIT #{Number(play.critical).toLocaleString()} · NEAR #{Number(play.near).toLocaleString()} · ERROR #{Number(play.error).toLocaleString()} · EARLY #{Number(play.early).toLocaleString()} · LATE #{Number(play.late).toLocaleString()}
              .live-feed-stats
                .live-feed-score #{Number(play.score).toLocaleString()}
                .live-feed-date #{play.dateStr}
      else
        p(style="color: #888; text-align: center; padding: 40px 0;") No plays yet.

block modal
  div.modal#live-feed-modal
    div.modal-background(onclick="closeLiveFeedModal()")
    div.modal-content.score-modal-content
      div.score-header
        img.score-header-jacket#lf-modal-jacket(src="" onerror="jacketFallback(this)" alt="")
        div.score-header-text
          h2#lf-modal-songname Song Name
          div.score-subtitle
            span.diff-badge#lf-modal-diff MXM
          div.score-played-by
            img.score-played-by-avatar#lf-modal-avatar(src="" alt="")
            span.score-played-by-text played by 
            span.score-played-by-name#lf-modal-username Player

      div.score-body
        div.score-rank-container
          div#lf-modal-rank(data-grade="S") S

        div.score-stats
          div.score-number#lf-modal-score 9,993,855
          div.score-meta-row
            div.score-meta-item
              span.score-meta-label EX Score
              span.score-meta-value#lf-modal-exscore 0
            div.score-meta-item
              span.score-meta-label Max Combo
              span.score-meta-value#lf-modal-maxchain 0
          div.score-medal-row
            span#lf-modal-medal PLAYED

        div.judgements-container
          div.judgements-title Judgements
          div.judgement-row.j-row-crit
            span.j-dot
            span.j-label CRITICAL
            span.j-value#lf-modal-crit 0
          div.judgement-row.j-row-near
            span.j-dot
            span.j-label NEAR
            span.j-value#lf-modal-near 0
          div.j-sub-row
            span.j-sub-item
              span.arrow-early ▲
              span#lf-modal-early 0
            span.j-sub-item
              span.arrow-late ▼
              span#lf-modal-late 0

          div.judgement-row.j-row-error
            span.j-dot
            span.j-label ERROR
            span.j-value#lf-modal-error 0

    button.modal-close.is-large(aria-label="close" onclick="closeLiveFeedModal()")

block scripts
  script.
    function jacketFallback(img) {
      var src = img.src;
      var match = src.match(/_(\d)\.(png|jpg|jpeg)(\?.*)?$/i);
      if (match) {
        var n = parseInt(match[1], 10);
        if (n > 1) {
          img.src = src.replace(/_\d\.(png|jpg|jpeg)/i, '_' + (n - 1) + '.$1');
          return;
        }
      }
      img.onerror = null;
      img.src = 'https://jackets.ryu7w7.xyz/sdvx/jk_dummy.png';
    }

    function getClearClassJS(clearVal) {
      var c = Number(clearVal);
      if (c === 5) return 'clear-puc';
      if (c === 4) return 'clear-uc';
      if (c === 3) return 'clear-exc';
      if (c === 2) return 'clear-comp';
      if (c === 1) return 'clear-fail';
      return '';
    }

    function getGradeText(score) {
      if (score >= 9900000) return 'S';
      if (score >= 9800000) return 'AAA+';
      if (score >= 9700000) return 'AAA';
      if (score >= 9500000) return 'AA+';
      if (score >= 9300000) return 'AA';
      if (score >= 9000000) return 'A+';
      if (score >= 8700000) return 'A';
      if (score >= 7500000) return 'B';
      if (score >= 6500000) return 'C';
      return 'D';
    }

    function getMedalText(clear) {
      var labels = ["NO DATA", "PLAYED", "EFFECTIVE CLEAR", "EXCESSIVE CLEAR", "MAXXIVE CLEAR", "ULTIMATE CHAIN", "PERFECT ULTIMATE CHAIN"];
      return labels[clear] || "PLAYED";
    }

    function openLiveFeedModal(el) {
      try {
        var data = JSON.parse(el.getAttribute('data-play'));
        if (!data) return;

        document.getElementById('lf-modal-songname').innerText = data.title || 'Song Name';
        document.getElementById('lf-modal-diff').innerText = (data.diff || '').toUpperCase();
        document.getElementById('lf-modal-jacket').src = data.jacketUrl || '';
        document.getElementById('lf-modal-avatar').src = data.avatarUrl || '/static/img/avatar.jpg';
        document.getElementById('lf-modal-username').innerText = data.username || 'Player';

        var gradeStr = getGradeText(Number(data.score || 0));
        var rankEl = document.getElementById('lf-modal-rank');
        rankEl.innerText = gradeStr;
        rankEl.setAttribute('data-grade', gradeStr);

        document.getElementById('lf-modal-score').innerText = Number(data.score || 0).toLocaleString();
        document.getElementById('lf-modal-exscore').innerText = Number(data.exscore || 0).toLocaleString();
        document.getElementById('lf-modal-maxchain').innerText = Number(data.maxChain || 0).toLocaleString();
        document.getElementById('lf-modal-crit').innerText = Number(data.critical || 0).toLocaleString();
        document.getElementById('lf-modal-near').innerText = Number(data.near || 0).toLocaleString();
        document.getElementById('lf-modal-error').innerText = Number(data.error || 0).toLocaleString();
        document.getElementById('lf-modal-early').innerText = Number(data.early || 0).toLocaleString();
        document.getElementById('lf-modal-late').innerText = Number(data.late || 0).toLocaleString();
        document.getElementById('lf-modal-medal').innerText = getMedalText(data.clear);

        document.getElementById('live-feed-modal').classList.add('is-active');
        document.documentElement.classList.add('is-clipped');
      } catch (e) {
        console.error(e);
      }
    }

    function closeLiveFeedModal() {
      var modal = document.getElementById('live-feed-modal');
      if (modal) modal.classList.remove('is-active');
      document.documentElement.classList.remove('is-clipped');
    }

    // Live update: prepend any new SDVX play from any player, in real time,
    // sourced from _layout.pug's 'live-score' window event (which itself
    // comes from the '/live/scores' SSE stream).
    window.addEventListener('live-score', function(e) {
      var evt = e.detail;
      if (!evt || evt.game !== 'sdvx') return;

      var list = document.getElementById('live-feed-list');
      if (!list) return;

      var play = {
        username: evt.username || 'Unknown',
        avatarUrl: evt.avatarUrl || '/static/img/avatar.jpg',
        title: evt.title || ('Chart #' + evt.mid),
        diff: evt.diff || '',
        jacketUrl: evt.jacketUrl || 'https://jackets.ryu7w7.xyz/sdvx/jk_dummy.png',
        score: evt.score || 0,
        exscore: evt.exscore || 0,
        clear: evt.clear || 0,
        grade: evt.grade || 0,
        maxChain: evt.maxChain || 0,
        critical: evt.critical || 0,
        near: evt.near || 0,
        error: evt.error || 0,
        early: evt.early || 0,
        late: evt.late || 0
      };

      var li = document.createElement('li');
      li.className = 'live-feed-card live-recent-play' + (play.clear ? ' ' + getClearClassJS(play.clear) : '');
      li.setAttribute('onclick', 'openLiveFeedModal(this)');
      li.setAttribute('data-play', JSON.stringify(play));
      li.innerHTML =
        '<img class="live-feed-avatar" src="' + play.avatarUrl + '" onerror="this.src=\'/static/img/avatar.jpg\'">' +
        '<img class="live-feed-jacket" src="' + play.jacketUrl + '" onerror="jacketFallback(this)">' +
        '<div class="live-feed-info">' +
          '<div>' +
            '<span class="live-feed-user">' + play.username + '</span>' +
            ' played ' +
            '<span class="live-feed-title">' + play.title + ' [' + play.diff + ']</span>' +
          '</div>' +
          '<div class="live-feed-meta">CRIT ' + play.critical.toLocaleString() + ' \u00b7 NEAR ' + play.near.toLocaleString() + ' \u00b7 ERROR ' + play.error.toLocaleString() + ' \u00b7 EARLY ' + play.early.toLocaleString() + ' \u00b7 LATE ' + play.late.toLocaleString() + '</div>' +
        '</div>' +
        '<div class="live-feed-stats">' +
          '<div class="live-feed-score">' + play.score.toLocaleString() + '</div>' +
          '<div class="live-feed-date">Just now</div>' +
        '</div>';

      list.insertBefore(li, list.firstChild);
      while (list.children.length > 100) {
        list.removeChild(list.lastChild);
      }
    });
